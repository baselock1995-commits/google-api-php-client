<?php
// Include the Google API client library
require_once 'vendor/autoload.php';

// Set up Google Sheets API
$client = new Google_Client();
$client->setApplicationName('Hotel Booking System');
$client->setScopes([Google_Service_Sheets::SPREADSHEETS]);
$client->setAuthConfig('credentials.json');
$client->setAccessType('offline');
$service = new Google_Service_Sheets($client);

// The ID of the Google Sheet you want to work with
$spreadsheetId = 'your_spreadsheet_id';  // Replace with your Google Sheet ID
$range = 'Sheet1!A:F';  // The range where you want to insert the data

// Collect form data
if ($_SERVER["REQUEST_METHOD"] == "POST") {
    $booking_number = $_POST['booking_number'];
    $guest_name = $_POST['guest_name'];
    $room_type = $_POST['room_type'];
    $check_in = $_POST['check_in'];
    $check_out = $_POST['check_out'];

    // Prepare data to be inserted into Google Sheets
    $values = [
        [$booking_number, $guest_name, $room_type, $check_in, $check_out]
    ];

    // Create the request body
    $body = new Google_Service_Sheets_ValueRange([
        'values' => $values
    ]);

    // Insert data into the sheet
    $params = [
        'valueInputOption' => 'RAW'
    ];
    $result = $service->spreadsheets_values->append($spreadsheetId, $range, $body, $params);

    // Confirmation message
    if ($result->getUpdates()->getUpdatedCells() > 0) {
        echo "Booking information has been successfully added to Google Sheets!";
    } else {
        echo "There was an error inserting the data.";
    }
}
?>

